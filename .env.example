# Tayad AI -- mobile app environment.
# Copy this file to .env and fill in the values. .env is gitignored.
#
# Only EXPO_PUBLIC_-prefixed variables are bundled into the app. The Supabase
# service role key and the Open Router key are NEVER prefixed EXPO_PUBLIC_ and
# never live here -- they are Edge Function secrets (see the bottom of this file).

# From the Supabase dashboard: Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# For local development against the Supabase CLI, use the values printed by
# `supabase start` instead of the hosted ones:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase start`>

# ---------------------------------------------------------------------------
# Edge Function secrets -- NOT bundled into the app, NOT set here.
#   Deployed:  supabase secrets set OPEN_ROUTER_API_KEY=...
#   Local:     put them in supabase/functions/.env (gitignored)
# ---------------------------------------------------------------------------
# OPEN_ROUTER_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # auto-injected by Supabase in deployed functions
