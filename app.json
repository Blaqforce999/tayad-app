{
  "expo": {
    "name": "Tayad",
    "slug": "tayad-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tayad",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tayad.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Tayad does not use your photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.tayad.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E8A33D"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
